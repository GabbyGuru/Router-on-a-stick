#switch confirguration 
#creating VLANs- configure the the ports connnecting to the router as 802.1Q trunk ports
#configure ports as accesss ports to end devices 


#Configure the port connecting to the router as a trunk

interface Gigabit0/1
 switchport mode trunk
 switchport trunk allowed vlan 10,20
 no shutdown
exit

#do the same for the second switch


