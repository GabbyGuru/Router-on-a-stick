router confirfuraton 
router interface - connected to switch trunk port 


enable
configure terminal
interface GigabitEthernet0/0
 no shutdown
 exit
#interface always has to be "no shutdown" even when not in use
#Ensure the physical interface is up (no IP address needed on the main interface)



#Configure VLAN 10 Subinterface
#adding .10 - indicates the vlan

interface GigabitEthernet0/0.10
encapsulation dot1Q 10
ip address 192.168.10.1 255.255.255.0
 exit


#Configure VLAN 20 Subinterface

interface GigabitEthernet0/0.20
 encapsulation dot1Q 20
 ip address 192.168.20.1 255.255.255.0
 exit



#comfirm that all interfaces are up or down as needed

Router#show ip interface brief
